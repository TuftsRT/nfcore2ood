#!/usr/bin/env bash

# Generate Open OnDemand batch-connect apps from locally downloaded nf-core
# pipelines. This tool intentionally focuses on app generation only.

set -euo pipefail
IFS=$'\n\t'

readonly SCRIPT_NAME="$(basename "$0")"
readonly NF2OOD_VERSION="1.2.0"

log() {
  printf '[%s] %s\n' "$SCRIPT_NAME" "$*"
}

die() {
  printf '[%s] ERROR: %s\n' "$SCRIPT_NAME" "$*" >&2
  exit 1
}

print_version() {
  printf 'nf2ood %s\n' "$NF2OOD_VERSION"
}

usage() {
  print_version
  printf '\n'
  cat <<'EOF'
Usage: nf2ood --output OUTPUT_DIR [--input INPUT_DIR]
              [--subcategory-map TSV] [--pipeline NAME] [--version VER]
              [--force] [--dry-run]

Generate Open OnDemand apps from nf-core pipeline downloads.

Required arguments:
  -o, --output           Directory where generated Open OnDemand apps will be written

Optional arguments:
  -i, --input            Directory containing nf-core pipeline directories.
                         Defaults to ${NF2OOD_PIPELINE_ROOT} when unset, since
                         that is normally where download_nfcore_pipeline.sh
                         installs pipelines for this site.
  -s, --subcategory-map  TSV mapping of pipeline name to OOD subcategory
                         Format: <pipeline_name>\t<subcategory>
                         Default: ./pipeline2subcategory.tsv when present
  -p, --pipeline NAME    Only process pipelines matching NAME. Accepts either
                         the full directory name (e.g. nf-core-rnaseq) or just
                         the slug (e.g. rnaseq). Repeatable.
  -v, --version VER      Only process versions matching VER (e.g. 3.18.0).
                         Repeatable.
  -f, --force            Delete the existing output directory before generating
                         apps. Ignored when --pipeline or --version is given so
                         unrelated apps in the output directory are preserved.
  -n, --dry-run          Print what would be generated without writing any files
  -V                     Print the nf2ood tool version and exit (use this
                         instead of --version, which is the pipeline-version
                         filter above)
  -h, --help             Show this help message

The input directory is expected to contain one directory per pipeline, with one
subdirectory per version. For example:

  INPUT_DIR/
    nf-core-rnaseq/
      3.18.0/
        3_18_0/nextflow_schema.json
EOF
}

config_value() {
  local variable_name=$1
  local default_value=$2
  printf '%s\n' "${!variable_name:-$default_value}"
}

require_env() {
  # Require a non-empty environment variable. Echo its value or die with a
  # message pointing at nf2ood.env.example.
  local variable_name=$1
  if [[ -z "${!variable_name:-}" ]]; then
    die "Required environment variable ${variable_name} is not set. Did you run 'source ./nf2ood.env'? See nf2ood.env.example."
  fi
  printf '%s\n' "${!variable_name}"
}

validate_environment() {
  # Validate site-required environment variables once, up front, before any
  # apps are generated. Variables with safe cross-site defaults are left for
  # config_value() in customize_generated_app.
  require_env NF2OOD_PIPELINE_ROOT >/dev/null
  require_env NF2OOD_SINGULARITY_CACHEDIR >/dev/null
  require_env NF2OOD_PARTITION_YML >/dev/null

  if [[ -z "${NF2OOD_SLURM_PROFILE:-}" ]]; then
    log "WARNING: NF2OOD_SLURM_PROFILE is not set. Falling back to 'default'. Generated apps will not use a site-specific Nextflow profile."
  fi
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

repo_root() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  printf '%s\n' "$script_dir"
}

prepare_output_dir() {
  local target_dir=$1
  local force=$2

  if [[ -e "$target_dir" && ! -d "$target_dir" ]]; then
    die "Output path exists and is not a directory: $target_dir"
  fi

  if [[ -d "$target_dir" ]]; then
    if [[ "$force" == "true" ]]; then
      log "Removing existing output directory: $target_dir"
      rm -rf "$target_dir"
    else
      printf "Output directory '%s' already exists. Delete it and regenerate? [y/N] " "$target_dir"
      read -r answer
      if [[ "$answer" =~ ^[Yy]$ ]]; then
        rm -rf "$target_dir"
      else
        die "Refusing to reuse an existing output directory without confirmation."
      fi
    fi
  fi

  mkdir -p "$target_dir"
}

list_pipelines() {
  local input_dir=$1
  find "$input_dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -exec basename {} \; | sort
}

list_versions() {
  local pipeline_dir=$1
  find "$pipeline_dir" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -exec basename {} \; | sort
}

pipeline_matches_filter() {
  # Returns 0 if no filter is set or if pipeline_name matches any entry.
  # Filters can be specified as the full dir name (nf-core-rnaseq) or just
  # the slug (rnaseq); both are accepted.
  local pipeline_name=$1
  (( ${#PIPELINE_FILTER[@]} == 0 )) && return 0

  local filter normalized_filter
  for filter in "${PIPELINE_FILTER[@]}"; do
    normalized_filter=$filter
    [[ "$normalized_filter" != nf-core-* ]] && normalized_filter="nf-core-${normalized_filter}"
    if [[ "$pipeline_name" == "$filter" || "$pipeline_name" == "$normalized_filter" ]]; then
      return 0
    fi
  done
  return 1
}

version_matches_filter() {
  # Returns 0 if no filter is set or if pipeline_version matches any entry.
  local pipeline_version=$1
  (( ${#VERSION_FILTER[@]} == 0 )) && return 0

  local filter
  for filter in "${VERSION_FILTER[@]}"; do
    if [[ "$pipeline_version" == "$filter" ]]; then
      return 0
    fi
  done
  return 1
}

locate_schema() {
  local input_dir=$1
  local pipeline_name=$2
  local pipeline_version=$3
  local version_underscored="${pipeline_version//./_}"
  local candidates=(
    "${input_dir}/${pipeline_name}/${pipeline_version}/${version_underscored}/nextflow_schema.json"
    "${input_dir}/${pipeline_name}/${pipeline_version}/nextflow_schema.json"
    "${input_dir}/${pipeline_name}/${version_underscored}/nextflow_schema.json"
    "${input_dir}/${pipeline_name}/nextflow_schema.json"
  )

  local candidate
  for candidate in "${candidates[@]}"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  # Non-fatal: caller logs and adds to the failure summary.
  return 1
}

lookup_tsv_value() {
  # Look up a key in a 2-column TSV. Comments (#) and blank lines are skipped,
  # as is a header row matching "pipeline" or "pipeline_name". Key match is
  # case-insensitive. Echoes the value when found and returns 0; returns 1 if
  # the file is missing, empty, or the key is not present.
  local tsv_path=$1
  local lookup_key=$2

  [[ -n "$tsv_path" && -f "$tsv_path" ]] || return 1

  local normalized_lookup
  normalized_lookup="$(printf '%s' "$lookup_key" | tr '[:upper:]' '[:lower:]')"

  local row_key row_value normalized_key
  while IFS=$'\t' read -r row_key row_value _; do
    row_key=${row_key//$'\r'/}
    row_value=${row_value//$'\r'/}

    [[ -z "${row_key//[[:space:]]/}" ]] && continue
    [[ "${row_key:0:1}" == "#" ]] && continue

    normalized_key="$(printf '%s' "$row_key" | tr '[:upper:]' '[:lower:]')"
    [[ "$normalized_key" == "pipeline" || "$normalized_key" == "pipeline_name" ]] && continue

    if [[ "$normalized_key" == "$normalized_lookup" ]]; then
      printf '%s\n' "$row_value"
      return 0
    fi
  done < "$tsv_path"

  return 1
}

determine_subcategory() {
  local pipeline_name=$1
  local subcategory_map_tsv=${SUBCATEGORY_MAP_TSV:-}

  local mapped
  if mapped="$(lookup_tsv_value "$subcategory_map_tsv" "$pipeline_name")" && [[ -n "$mapped" ]]; then
    printf '%s\n' "$mapped"
    return 0
  fi

  case "$pipeline_name" in
    nf-core-*)
      printf '%s\n' "${pipeline_name#nf-core-}" ;;
    *)
      printf 'bioinformatics\n' ;;
  esac
}

customize_generated_app() {
  local app_dir=$1
  local pipeline_name=$2
  local pipeline_version=$3

  local pipeline_slug="${pipeline_name#nf-core-}"
  local app_slug version_path subcategory
  local rendered_cluster rendered_default_directory rendered_module_name
  local rendered_pipeline_root rendered_singularity_cache rendered_slurm_profile
  local rendered_container_module rendered_partition_partial rendered_env_file

  app_slug="$(basename "$app_dir")"
  version_path="${pipeline_version}/${pipeline_version//./_}"
  subcategory="$(determine_subcategory "$pipeline_name")"

  # Required (validated up front by validate_environment).
  rendered_pipeline_root="$(require_env NF2OOD_PIPELINE_ROOT)"
  rendered_singularity_cache="$(require_env NF2OOD_SINGULARITY_CACHEDIR)"
  rendered_partition_partial="$(require_env NF2OOD_PARTITION_YML)"

  # Soft default; a warning is emitted once in validate_environment when unset.
  rendered_slurm_profile="${NF2OOD_SLURM_PROFILE:-default}"

  # Soft defaults that are reasonable cross-site values.
  rendered_cluster="$(config_value NF2OOD_CLUSTER "cluster")"
  rendered_default_directory="$(config_value NF2OOD_DEFAULT_DIRECTORY "$HOME")"
  rendered_env_file="$(config_value NF2OOD_ENV_FILE "")"

  # Module names use ${var-default} (no colon) so that an explicit empty
  # value in nf2ood.env means "do not load a module for this slot". Sites
  # that install nextflow / singularity / apptainer system-wide (no module
  # system, or modules without these names) can set either of these to ""
  # to skip the corresponding `module load` at job runtime. The runtime
  # script already guards each `module load` with an -n check, so an empty
  # value here propagates correctly.
  rendered_module_name="${NF2OOD_MODULE_NAME-nextflow}"
  rendered_container_module="${NF2OOD_CONTAINER_MODULE-singularity}"

  # Build the --set TOKEN=VALUE arglist once and apply all substitutions in a
  # single Python pass over the small set of files in the app dir.
  local -a customize_args=(
    --set "__PIPELINE_NAME__=${pipeline_name}"
    --set "__PIPELINE_SLUG__=${pipeline_slug}"
    --set "__PIPELINE_VERSION__=${pipeline_version}"
    --set "__PIPELINE_VERSION_PATH__=${version_path}"
    --set "__PIPELINE_DISPLAY_NAME__=nf-core/${pipeline_slug}"
    --set "__PIPELINE_SOURCE_URL__=https://nf-co.re/${pipeline_slug}"
    --set "__PIPELINE_REPOSITORY_URL__=https://github.com/nf-core/${pipeline_slug}"
    --set "__APP_SLUG__=${app_slug}"
    --set "__SUBCATEGORY__=${subcategory}"
    --set "__NF2OOD_CLUSTER__=${rendered_cluster}"
    --set "__NF2OOD_DEFAULT_DIRECTORY__=${rendered_default_directory}"
    --set "__NF2OOD_PARTITION_YML__=${rendered_partition_partial}"
    --set "__NF2OOD_MODULE_NAME__=${rendered_module_name}"
    --set "__NF2OOD_CONTAINER_MODULE__=${rendered_container_module}"
    --set "__NF2OOD_PIPELINE_ROOT__=${rendered_pipeline_root}"
    --set "__NF2OOD_SINGULARITY_CACHEDIR__=${rendered_singularity_cache}"
    --set "__NF2OOD_SLURM_PROFILE__=${rendered_slurm_profile}"
    --set "__NF2OOD_ENV_FILE__=${rendered_env_file}"
  )

  python3 "$REPO_ROOT/customize_app.py" "$app_dir" "${customize_args[@]}"
}

generate_app() {
  local input_dir=$1
  local output_dir=$2
  local pipeline_name=$3
  local pipeline_version=$4
  local schema_path app_dir rendered_version base_form base_params generated_form params_template

  rendered_version="${pipeline_version//./-}"
  app_dir="${output_dir}/${pipeline_name}-${rendered_version}"

  if ! schema_path="$(locate_schema "$input_dir" "$pipeline_name" "$pipeline_version")"; then
    log "WARNING: nextflow_schema.json not found for ${pipeline_name} ${pipeline_version}; skipping."
    return 1
  fi

  if [[ "${DRY_RUN:-false}" == "true" ]]; then
    log "[DRY-RUN] Would generate ${pipeline_name} ${pipeline_version}"
    log "[DRY-RUN]   schema: ${schema_path}"
    log "[DRY-RUN]   app:    ${app_dir}"
    return 0
  fi

  base_form="${app_dir}/form.template.erb"
  base_params="${app_dir}/nf-params.template.erb"
  generated_form="${app_dir}/form.yml.erb"
  params_template="${app_dir}/template/nf-params.json.erb"

  log "Generating ${pipeline_name} ${pipeline_version}"
  # Idempotent: when filtering, the output dir is reused, so an existing app
  # dir is removed first so cp -R produces a clean copy rather than nesting
  # the template inside it.
  [[ -d "$app_dir" ]] && rm -rf "$app_dir"
  # Explicit `if !` rather than relying on set -e. When generate_app is
  # called inside `if generate_app ...; then` (which it is, in the main
  # loop), bash silently disables set -e for the entire function body, so
  # any unchecked failure here would be ignored and the app would be
  # counted as successfully generated.
  if ! cp -R "$TEMPLATE_ROOT" "$app_dir"; then
    log "WARNING: failed to copy template for ${pipeline_name} ${pipeline_version}; skipping."
    return 1
  fi

  if ! python3 "$REPO_ROOT/json2ood.py" \
       "$schema_path" \
       "$generated_form" \
       "$base_form" \
       "$params_template" \
       "$base_params"; then
    log "WARNING: json2ood.py failed for ${pipeline_name} ${pipeline_version}; skipping."
    rm -rf "$app_dir"
    return 1
  fi

  rm -f "$base_form" "$base_params"

  if ! customize_generated_app "$app_dir" "$pipeline_name" "$pipeline_version"; then
    log "WARNING: customize step failed for ${pipeline_name} ${pipeline_version}; skipping."
    rm -rf "$app_dir"
    return 1
  fi
}

parse_args() {
  INPUT_DIR=""
  OUTPUT_DIR=""
  SUBCATEGORY_MAP_TSV=""
  FORCE_OVERWRITE="false"
  DRY_RUN="false"
  PIPELINE_FILTER=()
  VERSION_FILTER=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -i|--input)
        [[ $# -ge 2 ]] || die "Missing value for $1"
        INPUT_DIR=$2
        shift 2
        ;;
      -o|--output)
        [[ $# -ge 2 ]] || die "Missing value for $1"
        OUTPUT_DIR=$2
        shift 2
        ;;
      -s|--subcategory-map)
        [[ $# -ge 2 ]] || die "Missing value for $1"
        SUBCATEGORY_MAP_TSV=$2
        shift 2
        ;;
      -p|--pipeline)
        [[ $# -ge 2 ]] || die "Missing value for $1"
        PIPELINE_FILTER+=("$2")
        shift 2
        ;;
      -v|--version)
        [[ $# -ge 2 ]] || die "Missing value for $1"
        VERSION_FILTER+=("$2")
        shift 2
        ;;
      -f|--force)
        FORCE_OVERWRITE="true"
        shift
        ;;
      -n|--dry-run)
        DRY_RUN="true"
        shift
        ;;
      -V)
        print_version
        exit 0
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done

  [[ -n "$OUTPUT_DIR" ]] || die "Missing required argument: --output"
  # INPUT_DIR is resolved in main() after validate_environment so it can
  # default to NF2OOD_PIPELINE_ROOT when not given on the command line.
}

main() {
  parse_args "$@"

  require_command python3

  log "nf2ood ${NF2OOD_VERSION}"

  validate_environment

  # Default --input to NF2OOD_PIPELINE_ROOT (required env var, validated above)
  # so the common workflow of "download to NF2OOD_PIPELINE_ROOT, then generate
  # apps from it" works without repeating the path on the command line.
  if [[ -z "$INPUT_DIR" ]]; then
    INPUT_DIR="$NF2OOD_PIPELINE_ROOT"
    log "Using NF2OOD_PIPELINE_ROOT as --input: ${INPUT_DIR}"
  fi
  [[ -d "$INPUT_DIR" ]] || die "Input directory does not exist: $INPUT_DIR"

  REPO_ROOT="$(repo_root)"
  TEMPLATE_ROOT="${REPO_ROOT}/nfcore_ood_template"

  if [[ -z "$SUBCATEGORY_MAP_TSV" ]]; then
    SUBCATEGORY_MAP_TSV="${REPO_ROOT}/pipeline2subcategory.tsv"
  fi
  export SUBCATEGORY_MAP_TSV

  [[ -d "$TEMPLATE_ROOT" ]] || die "Template directory not found: $TEMPLATE_ROOT"

  local has_filter="false"
  if (( ${#PIPELINE_FILTER[@]} > 0 || ${#VERSION_FILTER[@]} > 0 )); then
    has_filter="true"
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    log "Dry run: no files will be created. Output directory ${OUTPUT_DIR} will not be modified."
  elif [[ "$has_filter" == "true" ]]; then
    # Filtered regeneration: keep unrelated apps in the output dir intact.
    if [[ "$FORCE_OVERWRITE" == "true" ]]; then
      log "Filter active: --force ignored so unrelated apps in ${OUTPUT_DIR} are preserved."
    fi
    mkdir -p "$OUTPUT_DIR"
  else
    prepare_output_dir "$OUTPUT_DIR" "$FORCE_OVERWRITE"
  fi

  # Result accumulators; printed by print_summary at the end.
  GENERATED_APPS=()
  FAILED_APPS=()
  SKIPPED_VERSIONS=()

  local pipeline_name pipeline_version
  while IFS= read -r pipeline_name; do
    [[ -n "$pipeline_name" ]] || continue

    if ! pipeline_matches_filter "$pipeline_name"; then
      continue
    fi

    log "Scanning pipeline: $pipeline_name"

    while IFS= read -r pipeline_version; do
      [[ -n "$pipeline_version" ]] || continue
      # Accept SemVer-ish version directories (e.g. 3.18.0, 1.2.6, 1.0.0-rc1).
      # This rejects dev/latest/main/etc. without needing an explicit skip log.
      if [[ ! "$pipeline_version" =~ ^[0-9]+\.[0-9] ]]; then
        SKIPPED_VERSIONS+=("${pipeline_name}/${pipeline_version}")
        continue
      fi

      if ! version_matches_filter "$pipeline_version"; then
        continue
      fi

      # Used as an `if` test so set -e does not abort the whole loop on a
      # per-app failure; the failure is recorded and reported in the summary.
      if generate_app "$INPUT_DIR" "$OUTPUT_DIR" "$pipeline_name" "$pipeline_version"; then
        GENERATED_APPS+=("${pipeline_name} ${pipeline_version}")
      else
        FAILED_APPS+=("${pipeline_name} ${pipeline_version}")
      fi
    done < <(list_versions "${INPUT_DIR}/${pipeline_name}")
  done < <(list_pipelines "$INPUT_DIR")

  print_summary

  if (( ${#FAILED_APPS[@]} > 0 )); then
    return 1
  fi
}

print_summary() {
  local generated_label="Generated:"
  if [[ "${DRY_RUN:-false}" == "true" ]]; then
    generated_label="Would generate:"
  fi
  log "----------------------------------------"
  log "Generation summary:"
  log "  ${generated_label}                ${#GENERATED_APPS[@]}"
  log "  Failed/skipped:           ${#FAILED_APPS[@]}"
  log "  Non-version dirs ignored: ${#SKIPPED_VERSIONS[@]}"

  if (( ${#FAILED_APPS[@]} > 0 )); then
    log ""
    log "Failed/skipped pipelines:"
    local entry
    for entry in "${FAILED_APPS[@]}"; do
      log "  - ${entry}"
    done
  fi

  if (( ${#SKIPPED_VERSIONS[@]} > 0 )); then
    log ""
    log "Non-version directories ignored (informational):"
    local entry
    for entry in "${SKIPPED_VERSIONS[@]}"; do
      log "  - ${entry}"
    done
  fi
  log "----------------------------------------"
}

main "$@"
